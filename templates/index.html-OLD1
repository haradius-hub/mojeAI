<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MojeAI - Asistent s pamětí</title>
    <style>
        /* === CSS STYLY === */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #0d1117; color: #e6edf3; height: 100vh; display: flex; }
        
        /* Sidebar */
        .sidebar { width: 340px; background: #161b22; padding: 16px; border-right: 1px solid #30363d; overflow-y: auto; flex-shrink: 0; }
        .sidebar h2 { color: #58a6ff; font-size: 16px; margin-bottom: 12px; }
        .sidebar label { display: block; margin: 8px 0 4px; color: #8b949e; font-size: 12px; font-weight: 600; }
        .sidebar select, .sidebar input, .sidebar textarea { width: 100%; padding: 6px 10px; background: #0d1117; border: 1px solid #30363d; color: #e6edf3; border-radius: 6px; font-size: 13px; }
        .sidebar select { cursor: pointer; }
        .sidebar select optgroup { background: #161b22; color: #e6edf3; }
        .sidebar select option { background: #0d1117; padding: 4px; }
        .sidebar textarea { resize: vertical; min-height: 60px; font-family: inherit; }
        .sidebar button { width: 100%; padding: 8px; margin-top: 8px; background: #238636; border: none; color: white; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 13px; }
        .sidebar button:hover { background: #2ea043; }
        .sidebar button.danger { background: #da3633; }
        .sidebar button.danger:hover { background: #f85149; }
        .sidebar button.secondary { background: #1f6feb; }
        .sidebar button.secondary:hover { background: #388bfd; }
        .sidebar .section { margin-top: 14px; padding-top: 14px; border-top: 1px solid #21262d; }
        
        /* Memory box */
        .memory-box { background: #0d1117; padding: 10px; border-radius: 6px; border: 1px solid #30363d; max-height: 180px; overflow-y: auto; margin-top: 6px; }
        .memory-item { font-size: 11px; color: #8b949e; border-bottom: 1px solid #21262d; padding: 4px 0; }
        .memory-item .label { color: #58a6ff; font-weight: 600; }
        
        /* Chat */
        .chat { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .chat-header { padding: 10px 20px; border-bottom: 1px solid #30363d; background: #161b22; display: flex; justify-content: space-between; align-items: center; }
        .chat-header h1 { font-size: 18px; color: #f0f6fc; }
        .chat-header .status-badge { font-size: 12px; color: #8b949e; }
        .chat-messages { flex: 1; padding: 16px 20px; overflow-y: auto; }
        .message { margin-bottom: 12px; max-width: 80%; padding: 10px 14px; border-radius: 12px; word-wrap: break-word; font-size: 14px; line-height: 1.5; }
        .message.user { background: #238636; color: white; margin-left: auto; }
        .message.assistant { background: #21262d; color: #e6edf3; margin-right: auto; border: 1px solid #30363d; }
        .message .time { font-size: 10px; color: #8b949e; margin-top: 4px; display: block; }
        .chat-input { padding: 10px 20px; border-top: 1px solid #30363d; background: #161b22; display: flex; gap: 10px; }
        .chat-input textarea { flex: 1; padding: 8px 12px; background: #0d1117; border: 1px solid #30363d; color: #e6edf3; border-radius: 8px; resize: none; font-family: inherit; font-size: 14px; }
        .chat-input textarea:focus { outline: none; border-color: #58a6ff; }
        .chat-input button { padding: 8px 20px; background: #1f6feb; border: none; color: white; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; }
        .chat-input button:hover { background: #388bfd; }
        .footer { font-size: 11px; color: #8b949e; padding: 5px 20px; background: #0d1117; border-top: 1px solid #30363d; display: flex; justify-content: space-between; }
        .footer .model-info { color: #58a6ff; }
        
        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0d1117; }
        ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #484f58; }
        
        .toast { position: fixed; bottom: 20px; right: 20px; background: #238636; color: white; padding: 12px 20px; border-radius: 8px; z-index: 1000; opacity: 0; transition: opacity 0.3s; max-width: 400px; }
        .toast.error { background: #da3633; }
        .toast.show { opacity: 1; }
        
        .slozka-polozka { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px solid #21262d; font-size: 12px; }
        .slozka-polozka .cesta { color: #e6edf3; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .slozka-polozka .pocet { color: #8b949e; margin-left: 8px; }
        .slozka-polozka .smazat { color: #da3633; cursor: pointer; margin-left: 8px; }
        .slozka-polozka .smazat:hover { color: #f85149; }
    </style>
</head>
<body>

<!-- === TOAST === -->
<div id="toast" class="toast"></div>

<!-- === SIDEBAR === -->
<div class="sidebar">
    <h2>⚙️ Nastavení</h2>
    
    <!-- Model -->
    <label>🧠 Model</label>
    <select id="modelSelect">
        <option value="">Načítám...</option>
    </select>
    
    <!-- API klíč -->
    <div class="section">
        <label>🔑 API klíč pro zvolený model</label>
        <input type="password" id="apiKlic" placeholder="Vlož API klíč...">
        <button onclick="ulozKlic()">💾 Uložit klíč</button>
        <div style="font-size:11px;color:#8b949e;margin-top:4px;">
            Soubor se uloží do <code>api_klic/[model].txt</code>
        </div>
    </div>
    
    <!-- Složky -->
    <div class="section">
        <label>📂 Připojené složky</label>
        <input type="text" id="slozkaCesta" placeholder="Cesta ke složce...">
        <button class="secondary" onclick="pridatSlozku()">➕ Připojit složku</button>
        <div id="slozkyList" style="font-size:12px;color:#8b949e;margin-top:6px;"></div>
    </div>
    
    <!-- Systémový prompt -->
    <div class="section">
        <label>📝 Systémový prompt</label>
        <textarea id="systemPrompt" rows="2" placeholder="Jak se má model chovat?"></textarea>
        <button class="secondary" onclick="ulozPrompt()">💾 Uložit prompt</button>
    </div>
    
    <!-- Internet -->
    <div class="section" style="display:flex;align-items:center;gap:10px;">
        <label style="margin:0;display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" id="internetPovolen" onchange="ulozInternet()">
            🌐 Povolit internet
        </label>
        <span style="font-size:11px;color:#8b949e;">(DuckDuckGo vyhledávání)</span>
    </div>
    
    <!-- Paměť -->
    <div class="section">
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <label style="margin:0;">🧠 Paměť</label>
            <button onclick="nactiPamet()" style="width:auto;padding:2px 10px;font-size:11px;background:#1f6feb;">↻</button>
        </div>
        <div class="memory-box" id="memoryList">
            <div style="color:#8b949e;font-size:12px;">Načítám...</div>
        </div>
    </div>
</div>

<!-- === CHAT === -->
<div class="chat">
    <div class="chat-header">
        <h1>🤖 MojeAI</h1>
        <span class="status-badge" id="modelStatus">📍 Načítám...</span>
    </div>
    
    <div class="chat-messages" id="messages">
        <div class="message assistant">👋 Ahoj! Zeptej se mě na cokoli. Mám přístup k tvé paměti a připojeným složkám.<span class="time">Právě teď</span></div>
    </div>
    
    <div class="chat-input">
        <textarea id="userInput" rows="2" placeholder="Napiš otázku... (Shift+Enter pro nový řádek)"></textarea>
        <button onclick="poslatDotaz()">➤ Odeslat</button>
    </div>
    
    <div class="footer">
        <span id="statusText">✅ Připraveno</span>
        <span class="model-info" id="aktivniModel">🔹 žádný</span>
    </div>
</div>

<script>
// ============ GLOBÁLNÍ STAV ============
let aktualniModel = '';

// ============ FUNKCE ============
function zobrazToast(zprava, error = false) {
    const toast = document.getElementById('toast');
    toast.textContent = zprava;
    toast.className = 'toast' + (error ? ' error' : '');
    toast.classList.add('show');
    clearTimeout(toast._timeout);
    toast._timeout = setTimeout(() => toast.classList.remove('show'), 4000);
}

async function nactiKonfiguraci() {
    try {
        const res = await fetch('/api/config');
        const data = await res.json();
        
        // Načteme lokální modely
        const lokalniRes = await fetch('/api/lokalni-modely');
        const lokalniModely = await lokalniRes.json();
        
        const select = document.getElementById('modelSelect');
        select.innerHTML = '';
        
        let prvniModel = null;
        
        // 1. Cloudové API modely
        const apiModely = ['gemini', 'deepseek', 'openai', 'claude'];
        const dostupneApi = apiModely.filter(m => data.dostupne_modele.includes(m));
        
        if (dostupneApi.length > 0) {
            const group = document.createElement('optgroup');
            group.label = '☁️ Cloudové modely';
            dostupneApi.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = m.charAt(0).toUpperCase() + m.slice(1);
                group.appendChild(opt);
                if (!prvniModel) prvniModel = m;
            });
            select.appendChild(group);
        }
        
        // 2. Lokální modely ze složky modely/
        if (lokalniModely.length > 0) {
            const group = document.createElement('optgroup');
            group.label = '📁 Lokální modely (ze složky)';
            lokalniModely.forEach(m => {
                const opt = document.createElement('option');
                opt.value = 'lokalni';
                opt.dataset.modelInfo = JSON.stringify(m);
                opt.textContent = `${m.nazev} (${m.typ})`;
                group.appendChild(opt);
                if (!prvniModel) prvniModel = 'lokalni';
            });
            select.appendChild(group);
        }
        
        // 3. Ollama
        if (data.dostupne_modele.includes('ollama')) {
            const opt = document.createElement('option');
            opt.value = 'ollama';
            opt.textContent = '🦙 Ollama (llama3.2)';
            select.appendChild(opt);
            if (!prvniModel) prvniModel = 'ollama';
        }
        
        // 4. Pokud nic není
        if (!prvniModel) {
            select.innerHTML = '<option value="">❌ Žádný model nenalezen</option>';
            document.getElementById('modelStatus').textContent = '⚠️ Vlož API klíč nebo model do složky modely/';
            document.getElementById('aktivniModel').textContent = '🔹 žádný';
        } else {
            // Nastavíme výchozí model
            const vychozi = data.vychozi || prvniModel;
            select.value = vychozi;
            aktualniModel = vychozi;
            document.getElementById('modelStatus').textContent = `📍 ${vychozi}`;
            document.getElementById('aktivniModel').textContent = `🔹 ${vychozi}`;
        }
        
        // Nastavit ostatní prvky
        document.getElementById('systemPrompt').value = data.config.system_prompt || '';
        document.getElementById('internetPovolen').checked = data.config.internet || false;
        
        // Načíst složky a paměť
        nactiSlozky();
        nactiPamet();
        
    } catch (e) {
        console.error('Chyba načítání konfigurace:', e);
        zobrazToast('Chyba načítání konfigurace', true);
    }
}

async function ulozKlic() {
    const klic = document.getElementById('apiKlic').value.trim();
    const model = document.getElementById('modelSelect').value;
    
    if (!klic) { zobrazToast('❌ Vlož API klíč!', true); return; }
    if (!model || model === 'lokalni' || model === 'ollama') { 
        zobrazToast('❌ Pro tento model není potřeba API klíč', true); 
        return; 
    }
    
    // Uložíme klíč do souboru
    const blob = new Blob([klic], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${model}.txt`;
    a.click();
    
    zobrazToast(`✅ Klíč pro ${model} stažen. Přesuň ho do api_klic/`);
    document.getElementById('apiKlic').value = '';
    
    // Po chvíli znovu načíst konfiguraci
    setTimeout(nactiKonfiguraci, 2000);
}

async function ulozPrompt() {
    const prompt = document.getElementById('systemPrompt').value.trim();
    if (!prompt) { zobrazToast('❌ Zadej prompt!', true); return; }
    
    try {
        await fetch('/api/prompt', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: prompt })
        });
        zobrazToast('✅ Prompt uložen');
    } catch (e) {
        zobrazToast('❌ Chyba při ukládání promptu', true);
    }
}

async function ulozInternet() {
    const povolen = document.getElementById('internetPovolen').checked;
    try {
        await fetch('/api/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ internet: povolen })
        });
        zobrazToast(povolen ? '✅ Internet povolen' : '❌ Internet zakázán');
    } catch (e) {
        zobrazToast('❌ Chyba', true);
    }
}

async function pridatSlozku() {
    const cesta = document.getElementById('slozkaCesta').value.trim();
    if (!cesta) { zobrazToast('❌ Zadej cestu ke složce!', true); return; }
    
    try {
        const res = await fetch('/api/slozka', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cesta: cesta })
        });
        const data = await res.json();
        if (data.status === 'ok') {
            zobrazToast(`✅ ${data.zprava}`);
            document.getElementById('slozkaCesta').value = '';
            nactiSlozky();
            nactiPamet();
        } else {
            zobrazToast(`❌ ${data.zprava}`, true);
        }
    } catch (e) {
        zobrazToast('❌ Chyba při přidávání složky', true);
    }
}

async function nactiSlozky() {
    try {
        const res = await fetch('/api/slozky');
        const data = await res.json();
        const list = document.getElementById('slozkyList');
        if (data.length === 0) {
            list.innerHTML = '<span style="color:#8b949e;">Žádné připojené složky</span>';
        } else {
            list.innerHTML = data.map(s => `
                <div class="slozka-polozka">
                    <span class="cesta">📁 ${s.cesta} ${s.chybi ? '⚠️' : ''}</span>
                    <span class="pocet">${s.pocet || 0} souborů</span>
                    <span class="smazat" onclick="odebratSlozku('${s.cesta}')">✕</span>
                </div>
            `).join('');
        }
    } catch (e) {
        console.error('Chyba načítání složek:', e);
    }
}

async function odebratSlozku(cesta) {
    try {
        await fetch('/api/slozka', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cesta: cesta })
        });
        nactiSlozky();
        zobrazToast('✅ Složka odebrána');
    } catch (e) {
        zobrazToast('❌ Chyba při odebírání', true);
    }
}

async function nactiPamet() {
    try {
        const res = await fetch('/api/pamet');
        const data = await res.json();
        const list = document.getElementById('memoryList');
        if (data.length === 0) {
            list.innerHTML = '<div style="color:#8b949e;font-size:12px;">Zatím žádné vzpomínky</div>';
        } else {
            list.innerHTML = data.map(item => `
                <div class="memory-item">
                    <span class="label">📄 ${item.soubor}</span>
                    <span style="color:#8b949e;">${item.obsah.length > 100 ? item.obsah.slice(0,100)+'...' : item.obsah}</span>
                </div>
            `).join('');
        }
    } catch (e) {
        console.error('Chyba načítání paměti:', e);
    }
}

async function poslatDotaz() {
    const input = document.getElementById('userInput');
    const dotaz = input.value.trim();
    if (!dotaz) return;
    input.value = '';
    input.style.height = 'auto';
    
    const select = document.getElementById('modelSelect');
    const model = select.value;
    const selectedOption = select.options[select.selectedIndex];
    let modelInfo = null;
    
    if (selectedOption && selectedOption.dataset.modelInfo) {
        try {
            modelInfo = JSON.parse(selectedOption.dataset.modelInfo);
        } catch(e) {}
    }
    
    if (!model) {
        zobrazToast('❌ Není vybraný žádný model', true);
        return;
    }
    
    // Zobrazit dotaz
    const messages = document.getElementById('messages');
    messages.innerHTML += `<div class="message user">${escapeHtml(dotaz)}<span class="time">${new Date().toLocaleTimeString()}</span></div>`;
    messages.scrollTop = messages.scrollHeight;
    
    document.getElementById('statusText').textContent = '⏳ Přemýšlím...';
    
    try {
        const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                dotaz: dotaz, 
                model: model,
                lokalni_model_info: modelInfo
            })
        });
        const data = await res.json();
        
        messages.innerHTML += `<div class="message assistant">${escapeHtml(data.odpoved).replace(/\n/g, '<br>')}<span class="time">${new Date().toLocaleTimeString()}</span></div>`;
        messages.scrollTop = messages.scrollHeight;
        document.getElementById('statusText').textContent = '✅ Hotovo';
        
        nactiPamet();
    } catch (err) {
        messages.innerHTML += `<div class="message assistant" style="color:#f85149;">❌ Chyba: ${escapeHtml(err.message)}</div>`;
        document.getElementById('statusText').textContent = '❌ Chyba';
        zobrazToast('❌ Chyba komunikace se serverem', true);
    }
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ============ EVENTY ============
document.getElementById('modelSelect').addEventListener('change', function() {
    aktualniModel = this.value;
    const displayName = this.options[this.selectedIndex]?.text || this.value || 'žádný';
    document.getElementById('aktivniModel').textContent = `🔹 ${displayName}`;
    document.getElementById('modelStatus').textContent = `📍 ${displayName}`;
});

document.getElementById('userInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        poslatDotaz();
    }
});

document.getElementById('userInput').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 150) + 'px';
});

// ============ START ============
nactiKonfiguraci();

// Automatické načítání paměti každých 15 sekund
setInterval(nactiPamet, 15000);
</script>
</body>
</html>